  (:action tomar
    :parameters (bot t1 barra)
    :precondition
      (and
        (robot-en bot barra)
        (taza-en t1 barra)
        (mano-libre bot)
      )
    :effect
      (and
        (sosteniendo bot t1)
        (not
          (taza-en t1 barra)
        )
        (not
          (mano-libre bot)
        )
      )
  )

    (:action mover
    :parameters (bot barra cafetera)
